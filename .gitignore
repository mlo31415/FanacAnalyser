# PyCharm
.idea/

# Python
__pycache__/
*.pyc
.venv*/
venv/

# PyInstaller output.  FanacAnalyzer.spec drives the build, and pyinstaller regenerates it.
build/
dist/
*.spec
# ...including the copy staged in the repo root for handing out
*.exe

# Shared modules symlinked in from their own repos by the mklinks*.bat scripts.
# The code lives in HelpersPackage, FanzineIssueSpecPackage, Locale and Settings -- these are just local links to it.
FanacFanzinesHelpers.py
FanzineDateTime.py
FanzineIssueSpecPackage.py
HelpersPackage.py
Locale.py
Log.py
PDFHelpers.py
Settings.py

# Generated reports, including dated snapshots ("FanacAnalyzer - Reports 2025-11-07 1029", "Reports (saved)").
# The first pattern is the current name; the second catches directories from before the rename.
FanacAnalyzer - Reports*/
Reports*/

# Run logs
Log.txt
Log Errors.txt
Log - *.txt

# Cache of the downloaded fanzine list (see the "Use Saved Fanzine List" parameter)
Saved Fanzine List.json

# Local machine configuration (Root Directory and Report Directory are paths on this machine)
FanacAnalyzer Parameters.txt

# Local data
People Canonical Names.txt

# README.md converted to Word for reading or sending on.  README.md is the original; regenerate as needed.
FA documentation.docx

# The scripts which create the symlinks above.  (The character class covers mkLinksSettings.bat's capital L,
# which core.ignorecase hides on Windows but would not on a case-sensitive filesystem.)
mk[lL]inks*.bat

# Local run-steering switches, edited to control one particular run rather than shared as configuration.
# ReadList() treats a missing file exactly like an all-commented one, so nothing depends on any of them
# being present.  (The patterns have no "/", so they match wherever Input Directory puts them.)
control-skippers.txt
control-unskippers.txt
control-OnlyThisReport.txt
